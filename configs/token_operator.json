{
  "model": {
    "n_q": 16,
    "card": 2048,
    "d": 128,
    "plan_dim": 512,
    "plan_blocks": 32,
    "hidden": 128,
    "blocks": 6,
    "kernel": 5,
    "dropout": 0.1,
    "use_style": false,
    "num_style_tokens": 16,
    "style_drop": 0.2,
    "style_gt_prob": 0.85,
    "use_dep_style_cond": true
  },
  "training": {
    "batch_size": 64,
    "num_workers": 4,
    "lr": 0.0003,
    "warmup_steps": 500,
    "epochs": 30,
    "lr_min": 1e-06,
    "max_len_tokens": 250,
    "grad_clip": 5.0,
    "val_ratio": 0.01,
    "first_half_weight": 1.5,
    "seed": 0,
    "mimi_checkpoint": "pretrained_models/best_mimi.pt",
    "codec_checkpoint": "checkpoints/prosody_codec.pt",
    "style_weight": 0.1
  }
}